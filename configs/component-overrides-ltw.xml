<config>
    <!-- Microsoft Link to Windows: Component Overrides for Launcher Icon & Services -->
    <component-override package="com.microsoft.appmanager">
        <!-- Launcher entry point (keep hidden from app drawer) -->
        <component class="com.microsoft.appmanager.StartUpCoreActivity" enabled="false" />
        <!-- Settings integration -->
        <component class="com.microsoft.appmanager.StartUpSettingActivity" enabled="true" />
        <!-- Quick Settings panel integration -->
        <component class="com.microsoft.appmanager.quicksettings.WindowsLinkTileService" enabled="true" />
        <!-- Background notification listener service -->
        <component class="com.microsoft.mmx.agents.PhoneNotificationsListenerService" enabled="true" />
    </component-override>
</config>
