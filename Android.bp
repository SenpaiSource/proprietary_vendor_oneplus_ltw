soong_namespace {
}

android_app_import {
    name: "LinktoWindows",
    owner: "oneplus",
    apk: "proprietary/product/priv-app/LinktoWindows/LinktoWindows.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
}

android_app_import {
    name: "DeviceIntegrationService",
    owner: "oneplus",
    apk: "proprietary/product/priv-app/DeviceIntegrationService/DeviceIntegrationService.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
}

android_app_import {
    name: "CrossDeviceServiceBroker",
    owner: "oneplus",
    apk: "proprietary/product/priv-app/CrossDeviceServiceBroker/CrossDeviceServiceBroker.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
}

cc_prebuilt_binary {
    name: "virtual_keyboard",
    owner: "oneplus",
    srcs: ["proprietary/system/bin/virtual_keyboard"],
    strip: {
        none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    relative_install_path: "",
}
